# --- Required in production ---
APP_URL=https://app.example.com            # public base URL (used in email links)
DATABASE_FILE=/data/app.db                 # SQLite file on a persistent volume
CRON_SECRET=change-me-long-random          # protects POST /api/jobs (optional: an in-process scheduler also runs)
PLATFORM_OWNER_EMAIL=you@example.com       # first platform super admin (created at boot if missing)
PLATFORM_OWNER_PASSWORD=change-me-long     # change after first sign-in; remove from env afterwards

# --- Email (transactional). Without it, verification is skipped and emails queue in Platform > Operations > Outbox
RESEND_API_KEY=
MAIL_FROM="Fieldnote <no-reply@yourdomain.com>"

# --- Payments. "test" simulates a provider (no real money). Wire a real INR provider before charging customers.
PAYMENT_PROVIDER=test

# --- Optional
# SEED_DEMO=1                # loads the Bright Studio / Northgate demo data on an empty database
# INSECURE_COOKIES=1         # only for local HTTP testing; never in production
# ALLOW_PRIVATE_WEBHOOKS=1   # only for local webhook testing
# DISABLE_SCHEDULER=1        # if you run POST /api/jobs from an external scheduler instead
