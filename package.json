{
  "name": "workspace-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.cjs && node tests/e2e/flows.cjs",
    "a11y": "node tests/e2e/a11y.cjs",
    "demo": "SEED_DEMO=1 INSECURE_COOKIES=1 DISABLE_SCHEDULER=1 PLATFORM_OWNER_EMAIL=ops@fieldnote.test PLATFORM_OWNER_PASSWORD=demo-pass-2026 next dev -p 3000"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "next": "^15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "playwright": "^1.50.0",
    "axe-core": "^4.10.0"
  }
}